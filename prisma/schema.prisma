datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EnquiryStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

model Enquiry {
  id          String        @id @default(cuid())
  name        String
  company     String
  country     String
  email       String
  phone       String?
  product     String?
  application String?
  quantity    String?
  message     String
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("enquiries")
}
